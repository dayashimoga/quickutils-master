[run]
source = scripts
omit =
    scripts/test_orchestrator.py
    scripts/verify_links_local.py
    scripts/build_all_local.py
    scripts/run_global_tests.py
    scripts/cancel_cf_builds.py
    scripts/redeploy_cloudflare.py
    scripts/github_distribute.py
    scripts/github_restore.py
    scripts/sync_project_scripts.py
    scripts/generate_projects_json.py
    scripts/post_social.py
    scripts/post_pinterest.py
    scripts/pinterest_automation.py
    scripts/indexnow_submit.py
    scripts/verify_repos.py
    scripts/smoke_test.py
    scripts/build_interactive.py
    scripts/generate_social_images.py
    scripts/distribute_pin_tests.py
    scripts/expand_data.py
    scripts/generate_new_sites.py
    scripts/create_project.py
    scripts/update_docs.py
    scripts/fix_syntax.py
    scripts/fix_slugs.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__
    if sys.platform == .win32
    pass
    raise NotImplementedError
